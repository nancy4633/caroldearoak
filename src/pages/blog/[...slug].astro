---
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await import.meta.glob('../../blog/*.md', { eager: true });
  return Object.entries(posts).map(([path, mod]: [string, any]) => ({
    params: { slug: path.split('/').pop()!.replace(/\.md$/, '') },
    props: { post: mod },
  }));
}

const { post } = Astro.props as any;
const { Content, frontmatter } = post;
---
<Base title={`${frontmatter.title} · 橡树旁`} description={frontmatter.description}>
  <div class="post-header">
    <h1>{frontmatter.title}</h1>
    <p class="meta">{frontmatter.date}</p>
  </div>
  <article class="prose">
    <Content />
  </article>
  <a class="back" href="/blog">← 回文章列表</a>
</Base>
