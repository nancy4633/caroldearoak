---
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = Object.entries(await import.meta.glob('../../../blog/*.md', { eager: true }));
  const byTag = new Map<string, any[]>();
  for (const [path, mod] of entries as [string, any][]) {
    const slug = path.split('/')!.pop()!.replace(/\.md$/, '');
    for (const t of mod.frontmatter.tags || []) {
      if (!byTag.has(t)) byTag.set(t, []);
      byTag.get(t)!.push({ slug, ...mod.frontmatter });
    }
  }
  return Array.from(byTag.entries()).map(([tag, posts]) => ({
    params: { tag },
    props: { posts: posts.sort((a, b) => String(b.date).localeCompare(String(a.date))) },
  }));
}

const { tag, posts } = Astro.props as any;
---
<Base title={`${tag} · 橡树旁`} description={`橡树旁「${tag}」系列文章`}>
  <div class="post-header">
    <h1>{tag}</h1>
    <p class="meta">{posts.length} 篇</p>
  </div>
  <ul class="post-list">
    {posts.map((p: any) => (
      <li>
        <span class="date">{p.date}</span>
        <div class="title"><a href={`/blog/${p.slug}/`}>{p.title}</a></div>
        {p.description && <div class="desc">{p.description}</div>}
      </li>
    ))}
  </ul>
  <a class="back" href="/blog">← 回全部文章</a>
</Base>
